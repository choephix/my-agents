#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' \
    'Usage: @omp-find [--] "needle"' \
    'Print matching OMP session IDs and text snippets, newest first, across all profiles.' \
    'Search is literal and case-insensitive, including reasoning and tool messages.'
}

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
  usage
  exit 0
fi
[[ ${1:-} != -- ]] || shift
if [[ $# != 1 || -z $1 ]]; then
  usage >&2
  exit 2
fi

omp-transcript search --profile all --reasoning --with-tools -n 0 -- "$1" |
  cut -f2,7
