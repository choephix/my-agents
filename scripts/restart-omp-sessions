#!/usr/bin/env bash
# restart-omp-sessions — exit and resume settled OMP agents in their own Herdr panes.
#
# Usage:
#   restart-omp-sessions              restart every settled (idle/done) OMP agent
#   restart-omp-sessions --dry-run    report what would happen, change nothing
#   restart-omp-sessions --pane ID    restrict every action to one pane
#
# Herdr is the sole source of truth for panes, agent kind and session paths.
# Revalidation and the ctrl+d send are not atomic: an agent that starts working
# inside that window can still be interrupted. Requires HERDR_ENV=1, omp, jq.

set -euo pipefail

SHELL_WAIT=20    # seconds: agent exited, pane shell back in foreground
RESUME_WAIT=90   # seconds: resumed agent settled on the same session
POLL=0.5

usage() { sed -n '2,/^$/{ s/^# \{0,1\}//; p }' "$0"; }
die() { echo "error: $*" >&2; exit 1; }
die_usage() { echo "error: $*" >&2; usage >&2; exit 2; }

dry=false pane_filter=""
while (( $# )); do
  case $1 in
    --dry-run)  dry=true; shift ;;
    --pane)     [[ ${2:-} ]] || die_usage "--pane requires a PANE_ID"
                pane_filter=$2; shift 2 ;;
    --pane=?*)  pane_filter=${1#--pane=}; shift ;;
    -h|--help)  usage; exit 0 ;;
    *)          die_usage "unknown argument: $1" ;;
  esac
done

[[ ${HERDR_ENV:-} == 1 ]] || die "not running inside Herdr (HERDR_ENV is not 1)"
for dep in herdr omp jq; do
  command -v "$dep" >/dev/null 2>&1 || die "required command not found: $dep"
done
snapshot=$(herdr agent list 2>&1) || die "herdr agent list failed: $snapshot"
jq -e '(.result.agents | type) == "array"' <<<"$snapshot" >/dev/null 2>&1 ||
  die "unexpected herdr agent list payload"

# POSIX single-quoting: safe for whatever shell owns the pane.
quote() { local s=$1; printf "'%s'" "${s//\'/\'\\\'\'}"; }

# Same pane, still OMP, still settled, still the same session file.
settled() { # pane session
  local out; out=$(herdr agent get "$1" 2>/dev/null) || return 1
  jq -e --arg p "$1" --arg s "$2" '.result.agent
    | . != null and .pane_id == $p and .agent == "omp"
      and .agent_session.value == $s
      and (.agent_status == "idle" or .agent_status == "done")' <<<"$out" >/dev/null 2>&1
}

# The pane shell itself owns the foreground process group again.
shell_ready() { # pane
  local out; out=$(herdr pane process-info --pane "$1" 2>/dev/null) || return 1
  jq -e '.result.process_info
    | .shell_pid != null and .foreground_process_group_id == .shell_pid' <<<"$out" >/dev/null 2>&1
}

poll() { # seconds predicate args...
  local end=$((SECONDS + $1)); shift
  while :; do
    "$@" && return 0
    (( SECONDS < end )) || return 1
    sleep "$POLL"
  done
}

mapfile -d '' -t f < <(jq -j '(.result.agents // [])[]
  | select((.agent? // "") == "omp")
  | (.pane_id? // "") + "\u0000" + (.agent_status? // "") + "\u0000"
    + (.agent_session?.value? // "") + "\u0000"' <<<"$snapshot")
(( ${#f[@]} % 3 == 0 )) || die "unexpected herdr agent list payload"

panes=() sessions=()
skipped=0 found=false
for (( i = 0; i < ${#f[@]}; i += 3 )); do
  p=${f[i]} state=${f[i+1]} session=${f[i+2]}
  [[ $p ]] || { echo "skip: malformed entry without pane_id"; (( ++skipped )); continue; }
  [[ -z $pane_filter || $p == "$pane_filter" ]] || continue
  found=true
  [[ $session == /* ]] || { echo "skip $p: no absolute session path"; (( ++skipped )); continue; }
  case $state in
    idle|done) panes+=("$p"); sessions+=("$session") ;;
    *)         echo "skip $p: state ${state:-<none>}"; (( ++skipped )) ;;
  esac
done
[[ -z $pane_filter ]] || $found || die "pane $pane_filter hosts no OMP agent"

acted=0 failures=0
for (( i = 0; i < ${#panes[@]}; i++ )); do
  p=${panes[i]} session=${sessions[i]}
  cmd="omp --resume=$(quote "$session")"

  settled "$p" "$session" || {
    echo "skip $p: changed since snapshot"; (( ++skipped )); continue; }

  if $dry; then
    echo "would restart $p: ctrl+d, then $cmd"; (( ++acted )); continue
  fi

  echo "restarting $p: $session"
  if ! herdr agent send-keys "$p" ctrl+d >/dev/null 2>&1; then
    echo "  fail $p: could not send ctrl+d"; (( ++failures )); continue
  fi
  if ! poll "$SHELL_WAIT" shell_ready "$p"; then
    echo "  fail $p: agent still running after ${SHELL_WAIT}s, not resuming"
    (( ++failures )); continue
  fi
  if ! herdr pane run "$p" "$cmd" >/dev/null 2>&1; then
    echo "  fail $p: could not run $cmd"; (( ++failures )); continue
  fi
  if ! poll "$RESUME_WAIT" settled "$p" "$session"; then
    echo "  fail $p: session did not settle within ${RESUME_WAIT}s"
    (( ++failures )); continue
  fi
  echo "  ok $p: resumed"
  (( ++acted ))
done

if $dry; then
  echo "dry run: $acted would restart, $skipped skipped, nothing changed"
  exit 0
fi
echo "restarted $acted of $(( acted + failures )), $skipped skipped"
(( failures == 0 ))
