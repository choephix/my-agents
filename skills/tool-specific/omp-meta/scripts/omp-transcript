#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)

usage() {
  cat >&2 <<'EOF'
Usage:
  omp-transcript <session.jsonl|id> [--with-tools|--hydrate] [--reasoning] [--ids]
                                    [-m <n> | --around <message-id> [-C <n>]]
                                    [--since <when>] [--until <when>] [--inherited] [--own]
  omp-transcript result --session <session.jsonl|id> --message-id <id>
  omp-transcript list [--cwd <dir>] [--under <dir>]... [--since <when>] [--until <when>]
                      [--all-forks] [--spawned | --no-spawned] [-n <count>]
  omp-transcript search [--] <pattern> [--regex] [--cwd <dir>] [--under <dir>]...
                        [--since <when>] [--until <when>] [--inherited] [--all-forks]
                        [--spawned | --no-spawned] [-n <count>]
                        [--reasoning] [--with-tools] [--hits [<n>]]
                        [--no-snippet] [--width <chars>]

Every mode also accepts --profile <name|default|all>, choosing which OMP
profile's sessions are scanned. Default: $OMP_SESSIONS_DIR when set,
otherwise all.

<when> is anything GNU date -d accepts (today, yesterday, 2026-10-06,
"last monday", "2026-10-06 14:00") or a shorthand like 2h, 3d, 1w. A spec
without a time of day means the start of that day, local time. The window
is half-open: since <= t < until.

A fork starts by copying its parent's history, stamped with the fork's own
creation time. Windows leave that copy out unless --inherited is given;
--own leaves it out of a render even without a window.

list and search rows carry an origin column, read from Paseo's agent
records ($PASEO_HOME/agents, default ~/.paseo/agents): user (opened in
Paseo by hand), agent (created by another agent), sched (created by a
schedule), or ? (Paseo never ran it: a terminal, herdr, omp -p). A fork
without a record of its own takes its lineage root's origin.
--no-spawned drops agent and sched rows; --spawned keeps only those.
? rows pass both.
EOF
  exit "${1:-2}"
}

fatal() {
  printf 'omp-transcript: %s\n' "$1" >&2
  exit 1
}

[[ ${1:-} == --help || ${1:-} == -h ]] && usage 0

mode=render
session=
message_id=
with_tools=false
hydrate=false
reasoning=false
ids=false
message_count=
filter_cwd=
list_count=10
search_pattern=
search_regex=false
search_snippet=true
search_count=20
search_width=140
search_hits=0
since_spec=
until_spec=
since_epoch=
until_epoch=
under_dirs=()
all_forks=false
spawned_filter=
inherited=false
own=false
around_id=
around_context=3
profile=

profile_args=()
while (($#)); do
  case $1 in
    --)
      profile_args+=("$@")
      break
      ;;
    --profile)
      (($# >= 2)) || usage
      profile=$2
      shift 2
      ;;
    *)
      profile_args+=("$1")
      shift
      ;;
  esac
done
set -- ${profile_args[@]+"${profile_args[@]}"}

omp_home=${HOME:-}/.omp
sessions_roots=()
if [[ -z $profile ]]; then
  if [[ ${OMP_SESSIONS_DIR+set} == set ]]; then profile=env; else profile=all; fi
fi
case $profile in
  env)
    sessions_roots=("$OMP_SESSIONS_DIR")
    ;;
  default)
    sessions_roots=("$omp_home/agent/sessions")
    ;;
  all)
    sessions_roots=("$omp_home/agent/sessions")
    for profile_root in "$omp_home"/profiles/*/agent/sessions; do
      [[ -d $profile_root ]] || continue
      sessions_roots+=("$profile_root")
    done
    ;;
  *)
    [[ -d $omp_home/profiles/$profile/agent/sessions ]] \
      || fatal "profile not found: $profile"
    sessions_roots=("$omp_home/profiles/$profile/agent/sessions")
    ;;
esac

case ${1:-} in
  result)
    mode=result
    shift
    while (($#)); do
      case $1 in
        --session)
          (($# >= 2)) || usage
          session=$2
          shift 2
          ;;
        --message-id)
          (($# >= 2)) || usage
          message_id=$2
          shift 2
          ;;
        *) usage ;;
      esac
    done
    [[ -n $session && -n $message_id ]] || usage
    ;;
  list)
    mode=list
    shift
    while (($#)); do
      case $1 in
        --cwd)
          (($# >= 2)) || usage
          filter_cwd=$2
          shift 2
          ;;
        --under)
          (($# >= 2)) || usage
          under_dirs+=("$2")
          shift 2
          ;;
        --since)
          (($# >= 2)) || usage
          since_spec=$2
          shift 2
          ;;
        --until)
          (($# >= 2)) || usage
          until_spec=$2
          shift 2
          ;;
        --all-forks)
          all_forks=true
          shift
          ;;
        --no-spawned)
          spawned_filter=exclude
          shift
          ;;
        --spawned)
          spawned_filter=only
          shift
          ;;
        -n)
          (($# >= 2)) || usage
          list_count=$2
          shift 2
          ;;
        *) usage ;;
      esac
    done
    [[ $list_count =~ ^(0|[1-9][0-9]{0,17})$ ]] || usage
    ;;
  search)
    mode=search
    shift
    while (($#)); do
      case $1 in
        --regex)
          search_regex=true
          shift
          ;;
        --reasoning)
          reasoning=true
          shift
          ;;
        --with-tools)
          with_tools=true
          shift
          ;;
        --no-snippet)
          search_snippet=false
          shift
          ;;
        --hits)
          if (($# >= 2)) && [[ $2 =~ ^[1-9][0-9]{0,3}$ ]]; then
            search_hits=$2
            shift 2
          else
            search_hits=5
            shift
          fi
          ;;
        --cwd)
          (($# >= 2)) || usage
          filter_cwd=$2
          shift 2
          ;;
        --under)
          (($# >= 2)) || usage
          under_dirs+=("$2")
          shift 2
          ;;
        --since)
          (($# >= 2)) || usage
          since_spec=$2
          shift 2
          ;;
        --until)
          (($# >= 2)) || usage
          until_spec=$2
          shift 2
          ;;
        --all-forks)
          all_forks=true
          shift
          ;;
        --no-spawned)
          spawned_filter=exclude
          shift
          ;;
        --spawned)
          spawned_filter=only
          shift
          ;;
        --inherited)
          inherited=true
          shift
          ;;
        -n)
          (($# >= 2)) || usage
          search_count=$2
          shift 2
          ;;
        --width)
          (($# >= 2)) || usage
          search_width=$2
          shift 2
          ;;
        --)
          (($# >= 2)) || usage
          [[ -z $search_pattern ]] || usage
          search_pattern=$2
          shift 2
          ;;
        -*) usage ;;
        *)
          [[ -z $search_pattern ]] || usage
          search_pattern=$1
          shift
          ;;
      esac
    done
    [[ -n $search_pattern ]] || usage
    [[ $search_count =~ ^(0|[1-9][0-9]{0,17})$ ]] || usage
    [[ $search_width =~ ^[1-9][0-9]{0,3}$ ]] || usage
    ;;
  '') usage ;;
  *)
    while (($#)); do
      case $1 in
        --with-tools)
          with_tools=true
          shift
          ;;
        --hydrate)
          with_tools=true
          hydrate=true
          shift
          ;;
        --reasoning)
          reasoning=true
          shift
          ;;
        --ids)
          ids=true
          shift
          ;;
        -m|--messages)
          (($# >= 2)) || usage
          [[ $2 =~ ^-?[1-9][0-9]{0,17}$ ]] || usage
          message_count=$2
          shift 2
          ;;
        --around)
          (($# >= 2)) || usage
          around_id=$2
          ids=true
          shift 2
          ;;
        --inherited)
          inherited=true
          shift
          ;;
        --own)
          own=true
          shift
          ;;
        -C|--context)
          (($# >= 2)) || usage
          [[ $2 =~ ^(0|[1-9][0-9]{0,3})$ ]] || usage
          around_context=$2
          shift 2
          ;;
        --since)
          (($# >= 2)) || usage
          since_spec=$2
          shift 2
          ;;
        --until)
          (($# >= 2)) || usage
          until_spec=$2
          shift 2
          ;;
        -*)
          usage
          ;;
        *)
          [[ -z $session ]] || usage
          session=$1
          shift
          ;;
      esac
    done
    [[ -n $session ]] || usage
    [[ -z $around_id || -z $message_count ]] || usage
    ;;
esac

command -v jq >/dev/null || fatal 'jq is required'

# Epoch seconds for a --since/--until spec. Day-granularity specs (today,
# yesterday, 2026-10-06, "last monday", "3 days ago") mean local midnight of
# that day; anything naming a time of day, and the Nm/Nh/Nd/Nw shorthand, is
# taken as is.
parse_when() {
  local spec=$1 epoch
  if [[ $spec =~ ^([0-9]+)([mhdw])$ ]]; then
    case ${BASH_REMATCH[2]} in
      m) spec="${BASH_REMATCH[1]} minutes ago" ;;
      h) spec="${BASH_REMATCH[1]} hours ago" ;;
      d) spec="${BASH_REMATCH[1]} days ago" ;;
      w) spec="${BASH_REMATCH[1]} weeks ago" ;;
    esac
    date -d "$spec" +%s 2>/dev/null
    return
  fi
  epoch=$(date -d "$spec" +%s 2>/dev/null) || return 1
  if [[ $spec != *:* && $spec != *[Tt][0-9][0-9]* && $spec != @* ]] \
     && ! [[ $spec =~ (hour|min|sec|now|noon|midnight) ]]; then
    epoch=$(date -d "$(date -d "@$epoch" +%F)" +%s 2>/dev/null) || return 1
  fi
  printf '%s' "$epoch"
}

if [[ -n $since_spec ]]; then
  since_epoch=$(parse_when "$since_spec") || fatal "cannot parse time: $since_spec"
fi
if [[ -n $until_spec ]]; then
  until_epoch=$(parse_when "$until_spec") || fatal "cannot parse time: $until_spec"
fi
if [[ -n $since_epoch && -n $until_epoch ]] && ((since_epoch >= until_epoch)); then
  fatal "empty window: --since $since_spec is not before --until $until_spec"
fi

# Window bounds as the tool prints them, and as a filename prefix: a session
# file is named after its start time, so a lexical compare of the first 19
# characters stands in for parsing it.
window_label() {
  local parts=()
  [[ -z $since_epoch ]] || parts+=("since $(date -ud "@$since_epoch" +%FT%TZ)")
  [[ -z $until_epoch ]] || parts+=("until $(date -ud "@$until_epoch" +%FT%TZ)")
  local IFS=' '
  printf '%s' "${parts[*]}"
}
until_name=
[[ -z $until_epoch ]] || until_name=$(date -ud "@$until_epoch" +%Y-%m-%dT%H-%M-%S)

# True when a session file started before --until. Files not named after
# their start time fall back to the mtime passed in.
started_before_until() {
  local path=$1 mtime=$2 name
  [[ -n $until_epoch ]] || return 0
  name=${path##*/}
  if [[ $name =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2} ]]; then
    [[ ${name:0:19} < $until_name ]]
  else
    ((mtime < until_epoch))
  fi
}

# --cwd is an exact match; every --under matches the directory itself and
# anything below it. Both apply when both are given.
wanted_cwd=
under_resolved=()
resolve_cwd_filters() {
  local dir
  if [[ -n $filter_cwd ]]; then
    wanted_cwd=$(realpath -- "$filter_cwd" 2>/dev/null) || fatal "cwd not found: $filter_cwd"
  fi
  for dir in ${under_dirs[@]+"${under_dirs[@]}"}; do
    under_resolved+=("$(realpath -m -- "$dir")")
  done
}

cwd_matches() {
  local cwd=$1 dir
  if [[ -n $wanted_cwd && $cwd != "$wanted_cwd" ]]; then return 1; fi
  ((${#under_resolved[@]})) || return 0
  for dir in "${under_resolved[@]}"; do
    [[ $cwd == "$dir" || $cwd == "$dir"/* ]] && return 0
  done
  return 1
}

session_id_of() {
  local name=${1##*/}
  name=${name%.jsonl}
  printf '%s' "${name#*_}"
}

# A parentSession value is a path in newer sessions and a bare id in older
# ones. A path that no longer exists, because the session moved to another
# profile or folder, and a bare id are both looked up by id under the
# sessions roots; the value is kept as is when no file matches.
parent_session_path() {
  local ref=$1 id root match
  if [[ $ref == */* && -f $ref ]]; then
    printf '%s' "$ref"
    return
  fi
  id=${ref##*/}
  id=${id%.jsonl}
  [[ $ref != */* ]] || id=${id#*_}
  for root in "${sessions_roots[@]}"; do
    for match in "$root"/*/*_"$id".jsonl; do
      if [[ -f $match ]]; then
        printf '%s' "$match"
        return
      fi
    done
  done
  printf '%s' "$ref"
}

# Follows parentSession links to the oldest ancestor and prints that
# session's id; a parent that no longer exists still names the root. Every
# fork of one conversation therefore shares a root, which is what lets list
# and search show a lineage once.
declare -A lineage_cache=()
lineage_root() {
  local path=$1 current root= parent chain=() steps=0
  current=$(realpath -m -- "$path")
  while :; do
    if [[ -n ${lineage_cache[$current]+set} ]]; then
      root=${lineage_cache[$current]}
      break
    fi
    chain+=("$current")
    parent=$(head -c 65536 -- "$current" 2>/dev/null \
      | grep -o -m1 '"parentSession":"[^"]*"' | cut -d'"' -f4) || true
    [[ -z $parent ]] || parent=$(parent_session_path "$parent")
    if [[ -z $parent || ! -f $parent ]] || ((++steps > 200)); then
      root=$(session_id_of "${parent:-$current}")
      break
    fi
    current=$(realpath -m -- "$parent")
  done
  for current in "${chain[@]}"; do lineage_cache[$current]=$root; done
  printf '%s' "$root"
}

# The lineage column: the root session's id for a fork, "-" otherwise.
lineage_label() {
  local path=$1 root
  root=$(lineage_root "$path")
  if [[ $root == "$(session_id_of "$path")" ]]; then printf -- '-'; else printf '%s' "$root"; fi
}

# Session id -> origin (user, agent, sched) for every OMP session Paseo has
# run, archived agents included. Paseo labels an agent made through
# create_agent with paseo.parent-agent-id and a scheduled run with
# paseo.schedule-id.
declare -A paseo_origin=()
load_paseo_origins() {
  local dir=${PASEO_HOME:-${HOME:-}/.paseo}/agents id origin
  [[ -d $dir ]] || return 0
  while IFS=$'\t' read -r id origin; do
    if [[ -n $id ]]; then paseo_origin[$id]=$origin; fi
  done < <(find "$dir" -mindepth 2 -maxdepth 2 -type f -name '*.json' -exec jq -r '
      (.runtimeInfo.sessionId
        // (.persistence.nativeHandle // "" | capture("_(?<id>[^_/]+)\\.jsonl$").id)) as $id
      | [$id,
         if .labels["paseo.parent-agent-id"] then "agent"
         elif .labels["paseo.schedule-id"] then "sched"
         else "user" end]
      | @tsv' {} +)
}

# Sets REPLY to the origin of session $1, else of its lineage root $2, else "?".
origin_of() {
  REPLY=${paseo_origin[$1]-${paseo_origin[$2]-?}}
}

origin_passes() {
  case $spawned_filter in
    exclude) [[ $1 != agent && $1 != sched ]] ;;
    only) [[ $1 == agent || $1 == sched ]] ;;
    *) return 0 ;;
  esac
}

# Header rows for the NUL-separated session files on stdin, one per file
# whose first five lines hold a session header. Fields are joined by \x1f,
# each escaped as @tsv would:
#   <path> <id> <title or "-"> <cwd> <parentSession>
# Only those five lines are read, every file through one head and one jq,
# so thousands of sessions cost well under a second.
read_headers() {
  xargs -0 -r head -v -n 5 -- 2>/dev/null | jq -nrR '
    def field: if type == "string" then . elif . == null then "" else tojson end;
    def row:
      .records as $records
      | (first($records[] | select(.type == "session")) // null) as $session
      | if $session == null then empty
        else
          [ .path,
            ($session.id // ""),
            ([$session.title, ($records[] | select(.type == "title") | .title)]
             | map(select(type == "string" and length > 0))
             | first // "-"),
            ($session.cwd // ""),
            ($session.parentSession // "") ]
          | map([field] | @tsv)
          | join("\u001f")
        end;
    foreach ((inputs | select(length > 0)), "==> <==") as $line (
      { path: null, records: [], done: null };
      if ($line | startswith("==> ")) and ($line | endswith(" <==")) then
        .done = (if .path == null then null else { path, records } end)
        | .path = $line[4:-4]
        | .records = []
      else
        .done = null
        | .records += [$line | (try fromjson catch null) | select(type == "object")]
      end;
      .done | select(. != null) | row)'
}

# Loads read_headers output into header_row and parent_ref, both by path.
declare -A header_row=() parent_ref=()
load_headers() {
  local row path
  while IFS= read -r row; do
    path=${row%%$'\x1f'*}
    header_row[$path]=$row
    parent_ref[$path]=${row##*$'\x1f'}
  done < "$1"
}

# lineage_root for a session whose header is loaded, without leaving the
# shell for every step: sets REPLY to the root id. Same walk, same answers;
# a parent outside the loaded headers, which --since or --profile can cause,
# is handed to lineage_root to follow on disk.
declare -A parent_path_cache=()
lineage_root_loaded() {
  local path=$1 ref parent steps=0
  while :; do
    ref=${parent_ref[$path]-}
    if [[ -z $ref ]]; then
      REPLY=${path##*/}
      REPLY=${REPLY%.jsonl}
      REPLY=${REPLY#*_}
      return
    fi
    if [[ $ref == */* && -n ${parent_ref[$ref]+set} ]]; then
      parent=$ref
    else
      [[ -n ${parent_path_cache[$ref]+set} ]] \
        || parent_path_cache[$ref]=$(parent_session_path "$ref")
      parent=${parent_path_cache[$ref]}
    fi
    if [[ -n ${parent_ref[$parent]+set} ]] && ((++steps <= 200)); then
      path=$parent
      continue
    fi
    if [[ -f $parent ]]; then
      REPLY=$(lineage_root "$parent")
    else
      REPLY=${parent##*/}
      REPLY=${REPLY%.jsonl}
      REPLY=${REPLY#*_}
    fi
    return
  done
}

tmpdir=
cleanup() {
  if [[ -n $tmpdir && -d $tmpdir ]]; then
    rm -rf -- "$tmpdir"
  fi
}
trap cleanup EXIT

make_tmpdir() {
  if [[ -z $tmpdir ]]; then
    tmpdir=$(mktemp -d)
  fi
}

# Fills the caller's `roots` array with every sessions root that exists.
collect_roots() {
  local root
  roots=()
  for root in "${sessions_roots[@]}"; do
    [[ -d $root ]] || continue
    roots+=("$root")
  done
  ((${#roots[@]})) || fatal "sessions root not found: ${sessions_roots[0]}"
}

# Session files newest first as "<mtime seconds>\t<path>\0", skipping files
# last written before --since.
find_session_files() {
  local roots=("$@") find_args=()
  [[ -z $since_epoch ]] || find_args+=(-newermt "@$since_epoch")
  find "${roots[@]}" -mindepth 2 -maxdepth 2 -type f -name '*.jsonl' \
    ${find_args[@]+"${find_args[@]}"} -printf '%T@\t%p\0' \
    | LC_ALL=C sort -z -t "$(printf '\t')" -k1,1gr \
    | while IFS= read -r -d '' entry; do
        mtime=${entry%%$'\t'*}
        printf '%s\t%s\0' "${mtime%%.*}" "${entry#*$'\t'}"
      done
}

# Splits one TSV row into the caller's `cols` array. `read` would fold the
# consecutive tabs of an empty field, so this walks the tabs by hand.
split_row() {
  local s=$1
  cols=()
  while [[ $s == *$'\t'* ]]; do
    cols+=("${s%%$'\t'*}")
    s=${s#*$'\t'}
  done
  cols+=("$s")
}

list_sessions() {
  local roots=() order=() fields=()
  local entry mtime path row id root lineage timestamp origin
  local matched=0
  declare -A seen_roots=() mtime_of=()

  collect_roots
  resolve_cwd_filters
  load_paseo_origins

  while IFS= read -r -d '' entry; do
    mtime=${entry%%$'\t'*}
    path=${entry#*$'\t'}
    started_before_until "$path" "$mtime" || continue
    order+=("$path")
    mtime_of[$path]=$mtime
  done < <(find_session_files "${roots[@]}")
  ((${#order[@]})) || return 0

  # Headers are read a chunk at a time, so a short list stops early; -n 0
  # reads them all at once, which keeps every parent in memory.
  local chunk=${#order[@]} start=0 index
  ((list_count == 0 || chunk <= 256)) || chunk=256
  make_tmpdir

  for ((index = 0; index < ${#order[@]}; index++)); do
    if ((index == start)); then
      printf '%s\0' "${order[@]:start:chunk}" | read_headers > "$tmpdir/headers"
      load_headers "$tmpdir/headers"
      ((start += chunk))
    fi
    path=${order[index]}
    row=${header_row[$path]-}
    [[ -n $row ]] || continue
    IFS=$'\x1f' read -r -a fields <<<"$row"
    if [[ -n $wanted_cwd ]] || ((${#under_resolved[@]})); then
      cwd_matches "${fields[3]-}" || continue
    fi
    id=${path##*/}
    id=${id%.jsonl}
    id=${id#*_}
    lineage_root_loaded "$path"
    root=$REPLY
    # Filtered before the dedupe, so a hidden fork never claims its lineage's row.
    origin_of "$id" "$root"
    origin=$REPLY
    origin_passes "$origin" || continue
    if ! $all_forks; then
      [[ -z ${seen_roots[$root]+set} ]] || continue
      seen_roots[$root]=1
    fi
    if [[ $root == "$id" ]]; then lineage=-; else lineage=$root; fi

    TZ=UTC printf -v timestamp '%(%Y-%m-%dT%H:%M:%SZ)T' "${mtime_of[$path]}"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$timestamp" "${fields[1]-}" "${fields[2]-}" "${fields[3]-}" "$path" "$lineage" "$origin"

    ((matched += 1))
    if ((list_count > 0 && matched >= list_count)); then break; fi
  done
}

# Accepts a path, or a session id / id prefix resolved under the sessions roots.
resolve_session() {
  local arg=$1 matches=() m root

  if [[ -f $arg ]]; then
    return 0
  fi
  if [[ $arg =~ ^[0-9a-fA-F][0-9a-fA-F-]{3,}$ ]]; then
    for root in "${sessions_roots[@]}"; do
      for m in "$root"/*/*_"$arg"*.jsonl; do
        [[ -f $m ]] || continue
        matches+=("$m")
      done
    done
    if ((${#matches[@]} == 1)); then
      session=${matches[0]}
      return 0
    elif ((${#matches[@]} == 0)); then
      fatal "no session with id: $arg"
    else
      printf 'omp-transcript: ambiguous session id: %s\n' "$arg" >&2
      printf '  %s\n' "${matches[@]}" >&2
      exit 1
    fi
  fi
  fatal "session not found: $arg"
}

# Longest run of the pattern that survives JSON encoding verbatim, so the
# raw-bytes prefilter can never be narrower than the parsed match. Quotes and
# backslashes get escaped, and non-ASCII may arrive as \uXXXX, so the run is
# printable ASCII minus " and \.
longest_plain_run() {
  local line best=

  while IFS= read -r line; do
    if ((${#line} > ${#best})); then best=$line; fi
  done < <(printf '%s\n' "$1" | LC_ALL=C tr -c '\40-\41\43-\133\135-\176' '\n')
  printf '%s' "$best"
}

resolve_grep() {
  local candidate version

  for candidate in "${OMP_GREP:-}" /usr/bin/grep /bin/grep "$(type -P grep || true)"; do
    [[ -n $candidate && -x $candidate ]] || continue
    version=$("$candidate" --version 2>/dev/null | head -n 1) || continue
    [[ $version == *"GNU grep"* ]] || continue
    printf '%s' "$candidate"
    return 0
  done
  return 1
}

write_search_helpers() {
  cat -- "$script_dir/omp-session.jq" "$script_dir/omp-fork.jq" > "$tmpdir/search.jq"
  cat >> "$tmpdir/search.jq" <<'JQ'

# Control characters become single spaces, so match offsets stay valid.
def snippet($re):
  . as $item
  | ($item.text | match($re; "i") | .offset) as $offset
  | ($item.text | gsub("[[:cntrl:]]"; " ")) as $clean
  | ([$offset - ($width / 3 | floor), 0] | max) as $start
  | ($start + $width) as $end
  | "\($item.role): "
    + (if $start > 0 then "…" else "" end)
    + ($clean[$start:$end] | gsub(" {2,}"; " ") | sub("^ +"; "") | sub(" +$"; ""))
    + (if $end < ($clean | length) then "…" else "" end);

# A record's timestamp as epoch seconds, or null.
def record_epoch:
  (.timestamp? // null)
  | if type == "string" then (sub("\\.[0-9]+Z$"; "Z") | try fromdateiso8601 catch null)
    else null
    end;

# Without a window every record counts. With one, only records that carry a
# timestamp inside it do, so titles and session headers stop matching, and a
# fork's copy of its parent's history counts only with --inherited.
def in_window($t; $copied):
  ($since == null and $until == null)
  or ($t != null
      and ($since == null or $t >= $since)
      and ($until == null or $t < $until)
      and ($inherited or ($copied | not)));

# Keeps the best $hits_max hits: user before developer, title, assistant, and
# the rest, then earliest first. A snippet is only built for a hit that makes
# the cut.
def keep_hit($item; $item_rank; $record; $re):
  if $hits_max == 0 then .
  else
    (.hit_list | length) as $count
    | (if $count < $hits_max then true
       else (.hit_list | max_by([.rank, .n]) | .rank) > $item_rank
       end) as $keep
    | if $keep | not then .
      else
        .hit_list = ((.hit_list
                      + [{
                          rank: $item_rank,
                          n: .hits,
                          id: (($record.id // "") | tostring),
                          ts: (($record.timestamp // "") | tostring | sub("\\.[0-9]+Z$"; "Z")),
                          line: ($item | snippet($re))
                        }])
                     | sort_by([.rank, .n])
                     | .[:$hits_max])
      end
  end;

(if $is_regex then $pattern else ($pattern | re_escape) end) as $re
| reduce (inputs | select(type == "object")) as $record
    ({ id: null, cwd: null, title: null, hits: 0, best: null, best_rank: 99, hit_list: [],
       run: { open: false, copied: false } };
      (if $record.type == "session" then
         (if ($record.id | type) == "string" then .id = $record.id else . end)
         | (if ($record.cwd | type) == "string" then .cwd = $record.cwd else . end)
         | .run = ($record | fork_start)
       else .run |= fork_step($record)
       end)
      | (if (["session", "title", "title_change"] | index($record.type // "")) != null
            and ($record.title | type) == "string" and $record.title != "" then
           .title = $record.title
         else .
         end)
      | if in_window($record | record_epoch; .run.copied) | not then .
        else
          reduce ($record
                  | visible
                  | .[]
                  | select((.text | type) == "string"
                           and .text != ""
                           and (.text | test($re; "i")))) as $item
            (.;
              .hits += 1
              | rank($item.role) as $item_rank
              | (if $item_rank < .best_rank then
                   .best_rank = $item_rank
                   | .best = ($item | snippet($re))
                 else .
                 end)
              | keep_hit($item; $item_rank; $record; $re))
        end)
| select(.hits > 0)
| ([ ($mtime | strftime("%Y-%m-%dT%H:%M:%SZ")),
     (.id // ($path | sub("^.*_"; "") | sub("\\.jsonl$"; ""))),
     (.hits | tostring),
     (.title // "-"),
     (.cwd // ""),
     $path ]
   + (if $with_snippet then [(.best // "")] else [] end)
   | @tsv)
  + ([.hit_list[] | "\n\t\(.id)\t\(.ts)\t\(.line)"] | join(""))
JQ

  cat > "$tmpdir/search-one" <<'WORKER'
#!/usr/bin/env bash
set -uo pipefail

path=${1:-}
[[ -n $path ]] || exit 0
mtime=$(stat -c '%Y' -- "$path" 2>/dev/null) || exit 0

scan() {
  jq -nr \
    --arg pattern "$OMPT_PATTERN" \
    --argjson is_regex "$OMPT_IS_REGEX" \
    --argjson reasoning "$OMPT_REASONING" \
    --argjson with_tools "$OMPT_WITH_TOOLS" \
    --argjson with_snippet "$OMPT_SNIPPET" \
    --argjson width "$OMPT_WIDTH" \
    --argjson hits_max "$OMPT_HITS" \
    --argjson inherited "$OMPT_INHERITED" \
    --argjson since "${OMPT_SINCE:-null}" \
    --argjson until "${OMPT_UNTIL:-null}" \
    --argjson mtime "$mtime" \
    --arg path "$path" \
    -f "$OMPT_PROGRAM" \
    "$1"
}

# A session being written right now can end mid-line; retry without it.
if ! row=$(scan "$path" 2>/dev/null); then
  row=$(sed -e '$d' -- "$path" | scan /dev/stdin 2>/dev/null) || exit 0
fi
[[ -n $row ]] || exit 0
printf '%020d\t%s\0' "$mtime" "$row" >> "$OMPT_ROWS/$$"
WORKER
  chmod +x -- "$tmpdir/search-one"
}

search_sessions() {
  local roots=() grep_bin prefilter_mode prefilter_pattern jobs
  local all_files candidates rows_dir rows sorted entry row first rest path root id lineage origin
  local cols=() fields=()
  local total=0 shown=0
  declare -A seen_roots=()

  collect_roots
  resolve_cwd_filters
  load_paseo_origins
  grep_bin=$(resolve_grep) || fatal 'GNU grep is required by search'

  if $search_regex; then
    if ! jq -n --arg p "$search_pattern" '"" | test($p; "i")' >/dev/null 2>&1; then
      fatal "invalid regex: $search_pattern"
    fi
    prefilter_pattern=$search_pattern
    if "$grep_bin" -qP -e x <<<x 2>/dev/null; then
      prefilter_mode=-P
    else
      prefilter_mode=-E
    fi
  else
    prefilter_mode=-F
    prefilter_pattern=$(longest_plain_run "$search_pattern")
  fi

  make_tmpdir
  all_files=$tmpdir/search-files
  candidates=$tmpdir/search-candidates
  rows_dir=$tmpdir/search-rows
  rows=$tmpdir/search-rows.nul
  sorted=$tmpdir/search-rows-sorted
  mkdir -p -- "$rows_dir"
  write_search_helpers

  # The window and cwd filters cut the file list before any content is read:
  # mtime via find, start time via the file name, cwd via the header.
  : > "$all_files"
  while IFS= read -r -d '' entry; do
    path=${entry#*$'\t'}
    started_before_until "$path" "${entry%%$'\t'*}" || continue
    printf '%s\0' "$path" >> "$all_files"
  done < <(find_session_files "${roots[@]}")
  read_headers < "$all_files" > "$tmpdir/headers"
  load_headers "$tmpdir/headers"
  if [[ -n $wanted_cwd ]] || ((${#under_resolved[@]})); then
    : > "$tmpdir/in-cwd"
    while IFS= read -r -d '' path; do
      row=${header_row[$path]-}
      IFS=$'\x1f' read -r -a fields <<<"$row"
      cwd_matches "${fields[3]-}" || continue
      printf '%s\0' "$path" >> "$tmpdir/in-cwd"
    done < "$all_files"
    mv -- "$tmpdir/in-cwd" "$all_files"
  fi

  # Cheap raw-bytes pass first: parsing every session costs minutes, and the
  # text worth searching is a low single-digit percentage of the bytes.
  if [[ -n $prefilter_pattern ]]; then
    xargs -0 -r -- "$grep_bin" -laZ -i "$prefilter_mode" -e "$prefilter_pattern" \
      < "$all_files" > "$candidates" || true
  else
    cp -- "$all_files" "$candidates"
  fi

  jobs=$(nproc 2>/dev/null) || jobs=4
  export OMPT_PROGRAM=$tmpdir/search.jq
  export OMPT_PATTERN=$search_pattern
  export OMPT_IS_REGEX=$search_regex
  export OMPT_REASONING=$reasoning
  export OMPT_WITH_TOOLS=$with_tools
  export OMPT_SNIPPET=$search_snippet
  export OMPT_WIDTH=$search_width
  export OMPT_HITS=$search_hits
  export OMPT_INHERITED=$inherited
  export OMPT_SINCE=$since_epoch
  export OMPT_UNTIL=$until_epoch
  export OMPT_ROWS=$rows_dir
  xargs -0 -r -P "$jobs" -n 1 -- "$tmpdir/search-one" < "$candidates" || true

  : > "$rows"
  find "$rows_dir" -type f -exec cat -- {} + >> "$rows"
  LC_ALL=C sort -z -r -- "$rows" > "$sorted"

  # Each entry is one row, followed by its hit lines when --hits is on. The
  # lineage and origin columns go in after the path, so the snippet stays last.
  while IFS= read -r -d '' entry; do
    row=${entry#*$'\t'}
    first=${row%%$'\n'*}
    rest=${row#"$first"}
    split_row "$first"
    path=${cols[5]}
    id=${path##*/}
    id=${id%.jsonl}
    id=${id#*_}
    if [[ -n ${parent_ref[$path]+set} ]]; then
      lineage_root_loaded "$path"
      root=$REPLY
    else
      root=$(lineage_root "$path")
    fi
    origin_of "$id" "$root"
    origin=$REPLY
    origin_passes "$origin" || continue
    if ! $all_forks; then
      [[ -z ${seen_roots[$root]+set} ]] || continue
      seen_roots[$root]=1
    fi
    if [[ $root == "$id" ]]; then lineage=-; else lineage=$root; fi
    ((total += 1))
    if ((search_count == 0 || shown < search_count)); then
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' "${cols[@]:0:6}" "$lineage" "$origin"
      if $search_snippet; then printf '\t%s' "${cols[6]-}"; fi
      printf '%s\n' "$rest"
      ((shown += 1))
    fi
  done < "$sorted"

  if ((total > shown)); then
    printf 'omp-transcript: %d sessions matched, showing %d (raise with -n, 0 for all)\n' \
      "$total" "$shown" >&2
  fi
}

if [[ $mode == list ]]; then
  list_sessions
  exit 0
fi

if [[ $mode == search ]]; then
  search_sessions
  exit 0
fi

resolve_session "$session"
session=$(realpath -- "$session")
sidecar_dir=${session%.jsonl}
make_tmpdir
branch_file=$tmpdir/branch.json

if [[ -n $around_id ]] && ! grep -qF -- "\"id\":\"$around_id\"" "$session"; then
  fatal "message not found: $around_id"
fi

# The active branch: the last record's ancestry. With --around, the branch
# through that message instead: its ancestry plus its latest descendant's,
# so a hit on a rewound branch still reads in its own context. Records a fork
# copied from its parent are marked _omp_copied.
if ! jq -sc --arg around "$around_id" "$(<"$script_dir/omp-fork.jq")"'
  def ancestors($index):
    . as $record
    | $record,
      (if (($record.parentId? // null) != null) and ($index[$record.parentId] != null)
       then $index[$record.parentId] | ancestors($index)
       else empty
       end);

  def branch:
    . as $records
    | (reduce $records[] as $record ({};
        if (($record.id? // null) != null)
        then .[$record.id] = $record
        else .
        end)) as $index
    | (if $around == "" then
         [$records[] | select((.id? // null) != null and has("parentId"))] | last
       else
         (reduce $records[] as $record ({($around): true};
            if (($record.id? // null) != null)
               and (($record.parentId? // null) != null)
               and (.[$record.parentId] == true)
            then .[$record.id] = true
            else .
            end)) as $under
         | [$records[] | select((.id? // null) != null and $under[.id] == true)] | last
       end) as $leaf
    | if $leaf == null
      then error("session contains no conversation branch")
      else [$leaf | ancestors($index)] | reverse
      end;

  fork_copy_ids as $copied
  | branch
  | map(if $copied[.id? // ""] == true then . + {_omp_copied: true} else . end)
' "$session" > "$branch_file"; then
  fatal 'could not read the active conversation branch'
fi

write_text_content() {
  local record=$1 output=$2
  jq -j '
    def text_content($content):
      if ($content | type) == "string" then $content
      elif ($content | type) == "array" then
        [$content[] | select(.type == "text") | .text] | join("\n")
      else ""
      end;
    text_content(.message.content)
  ' <<<"$record" > "$output"
}

artifact_path=
find_artifact() {
  local artifact=$1
  local had_nullglob=false
  local matches=()

  shopt -q nullglob && had_nullglob=true
  shopt -s nullglob
  matches=("$sidecar_dir/$artifact."*)
  $had_nullglob || shopt -u nullglob

  ((${#matches[@]} > 0)) || return 1
  [[ -f ${matches[0]} && -r ${matches[0]} ]] || return 1
  artifact_path=${matches[0]}
}

extract_shake_region() {
  local input=$1 region=$2 output=$3
  jq -Rsrj --argjson wanted "$region" '
    def blank: test("^\\s*$");
    split("\n") as $lines
    | ([range(0; $lines | length)
        | select($lines[.] | test("^### region \($wanted) \\("))] | first) as $start
    | if $start == null then error("region not found")
      else
        (([range($start + 1; $lines | length)
           | select($lines[.] | test("^### region [0-9]+ \\("))] | first)
         // ($lines | length)) as $end
        | $lines[$start + 1:$end]
        | if length > 0 and (.[0] | blank) then .[1:] else . end
        | until(length == 0 or (.[-1] | blank | not); .[:-1])
        | join("\n")
      end
  ' "$input" > "$output"
}

hydration_state=
hydration_recovered=false
hydrate_record() {
  local record=$1 output=$2
  local raw_artifact shaken_info shaken_artifact shaken_region resolved_path recovered_file

  hydration_state=ok
  hydration_recovered=false
  write_text_content "$record" "$output"

  raw_artifact=$(jq -Rsr '
    [split("\n")[] | capture("^\\[raw output: artifact://(?<artifact>[0-9]+)\\]$")? | .artifact] | last // empty
  ' "$output")
  if [[ -n $raw_artifact ]]; then
    if find_artifact "$raw_artifact"; then
      cat -- "$artifact_path" > "$output"
      hydration_recovered=true
    fi
    return 0
  fi

  if jq -Rse '
      sub("\\s+$"; "")
      | test("^\\[shaken ~[0-9]+ tokens — recover: artifact://[0-9]+ \\(region [0-9]+\\)\\]$")
    ' "$output" >/dev/null; then
    shaken_info=$(jq -Rsr '
      sub("\\s+$"; "")
      | capture("^\\[shaken ~[0-9]+ tokens — recover: artifact://(?<artifact>[0-9]+) \\(region (?<region>[0-9]+)\\)\\]$")
      | "\(.artifact)\t\(.region)"
    ' "$output")
    shaken_artifact=${shaken_info%%$'\t'*}
    shaken_region=${shaken_info#*$'\t'}
    if find_artifact "$shaken_artifact"; then
      recovered_file=$tmpdir/recovered
      if extract_shake_region "$artifact_path" "$shaken_region" "$recovered_file" 2>/dev/null; then
        mv -- "$recovered_file" "$output"
        hydration_recovered=true
        return 0
      fi
    fi
  elif ! jq -Rse '
      sub("\\s+$"; "")
      | test("^\\[Output truncated - [0-9]+ tokens\\]$")
    ' "$output" >/dev/null; then
    return 0
  fi

  if jq -e '(.message.details.displayContent.text | type) == "string"' >/dev/null <<<"$record"; then
    jq -j '.message.details.displayContent.text' <<<"$record" > "$output"
    hydration_recovered=true
    return 0
  fi
  if jq -e '(.message.details.truncation.content | type) == "string"' >/dev/null <<<"$record"; then
    jq -j '.message.details.truncation.content' <<<"$record" > "$output"
    hydration_recovered=true
    return 0
  fi
  if jq -e '(.message.details.resolvedPath | type) == "string"' >/dev/null <<<"$record"; then
    resolved_path=$(jq -r '.message.details.resolvedPath' <<<"$record")
    if [[ -f $resolved_path && -r $resolved_path ]]; then
      cat -- "$resolved_path" > "$output"
      hydration_recovered=true
      return 0
    fi
  fi

  hydration_state=unrecoverable
}


if [[ $mode == result ]]; then
  record=$(jq -c --arg id "$message_id" '[.[] | select(.id == $id)] | first' "$branch_file")
  [[ $record != null ]] || fatal 'message is not on the active branch'
  [[ $(jq -r '.type == "message" and .message.role == "toolResult"' <<<"$record") == true ]] || fatal 'message is not a tool result'

  result_body=$tmpdir/result-body
  hydrate_record "$record" "$result_body"
  cat -- "$result_body"
  if [[ $hydration_state == unrecoverable ]]; then
    printf 'omp-transcript: full output not recorded in session\n' >&2
    exit 3
  fi
  exit 0
fi

slice_count=${message_count:-null}
render_plan=$tmpdir/render-plan.json

jq -c \
  --arg session "$session" \
  --argjson count "$slice_count" \
  --argjson with_tools "$with_tools" \
  --argjson reasoning "$reasoning" \
  --argjson since "${since_epoch:-null}" \
  --argjson until "${until_epoch:-null}" \
  --argjson inherited "$inherited" \
  --argjson own "$own" \
  --arg around "$around_id" \
  --argjson context "$around_context" '
  def record_epoch:
    (.timestamp? // null)
    | if type == "string" then (sub("\\.[0-9]+Z$"; "Z") | try fromdateiso8601 catch null)
      else null
      end;

  # The copy a fork made of its parent history is left out by --own, and by any
  # window unless --inherited.
  def in_window:
    if ._omp_copied == true and $own then false
    elif $since == null and $until == null then true
    else
      record_epoch as $t
      | $t != null
        and ($since == null or $t >= $since)
        and ($until == null or $t < $until)
        and ($inherited or ._omp_copied != true)
    end;

  def text_content($record):
    $record.message.content as $content
    | if ($content | type) == "string" then $content
      elif ($content | type) == "array" then
        [$content[] | select(.type == "text") | (.text // "")] | join("\n")
      else ""
      end;

  def fence($body):
    ((([$body | scan("`+") | length] | max) // 0) + 1) as $length
    | "`" * (if $length < 3 then 3 else $length end);

  def tagged_section($tag; $attributes; $body):
    "<\($tag)\($attributes)>\n\($body)\n</\($tag)>\n\n";

  def fenced_section($tag; $attributes; $body; $info):
    fence($body) as $fence
    | "<\($tag)\($attributes)>\n\($fence)\($info)\n\($body)\n\($fence)\n</\($tag)>\n\n";

  def render_sections($record):
    if $record.type == "message" then
      if (["user", "developer"] | index($record.message.role)) != null then
        text_content($record) as $body
        | if $body == "" then []
          else [tagged_section($record.message.role; ""; $body)]
          end
      elif $record.message.role == "bashExecution" then
        ($record.message.output // "") as $body
        | (" command=\"\($record.message.command)\""
           + (if $record.message | has("exitCode") then " exit=\"\($record.message.exitCode)\"" else "" end)
           + (if $record.message.cancelled == true then " cancelled=\"true\"" else "" end)
           + (if $record.message.truncated == true then " truncated=\"true\"" else "" end)) as $attributes
        | [fenced_section("bash-execution"; $attributes; $body; "")]
      elif $record.message.role == "fileMention" then
        [$record.message.files[]? as $file
          | ($file.path // "") as $path
          | if ($file.image | type) == "object" then
              "<file-mention path=\"\($path)\" image=\"\($file.image.mimeType)\" />\n\n"
            else
              ($file.content | if type == "string" then . else "" end) as $body
              | (" path=\"\($path)\""
                 + (if $file | has("lineCount") then " lines=\"\($file.lineCount)\"" else "" end)
                 + (if $body != "" then " bytes=\"\($body | utf8bytelength)\"" else "" end)) as $attributes
              | if $with_tools then
                  fenced_section("file-mention"; $attributes; $body; "")
                else
                  "<file-mention\($attributes) />\n\n"
                end
            end]
      elif $record.message.role == "assistant" then
        [$record.message.content[]?
          | if $reasoning and .type == "thinking" and (.thinking | type) == "string" and .thinking != "" then
              tagged_section("reasoning"; ""; .thinking)
            elif .type == "text" and (.text | type) == "string" and .text != "" then
              tagged_section("assistant"; ""; .text)
            elif .type == "toolCall" and $with_tools then
              ((.arguments // .input // {}) | tojson) as $body
              | fenced_section("tool-call"; " name=\"\(.name // "unknown")\""; $body; "json")
            else empty
            end]
      elif $record.message.role == "toolResult" and $with_tools then
        text_content($record) as $body
        | ($record.message.toolName // "unknown") as $tool
        | (if $record.message.isError then "error" else "successful" end) as $status
        | ("omp-transcript result --session \(($session | @sh)) --message-id \(($record.id // "" | tostring | @sh))") as $command
        | [fenced_section(
            "tool-result";
            " tool=\"\($tool)\" status=\"\($status)\" bytes=\"\($body | utf8bytelength)\"";
            $command;
            "bash"
          )]
      else []
      end
    elif $record.type == "custom_message"
         and ($record.content | type) == "string"
         and $record.content != ""
         and ($record.customType | type) == "string" then
      [tagged_section("custom-message"; " type=\"\($record.customType)\""; $record.content)]
    elif $record.type == "compaction"
         and ($record.summary | type) == "string"
         and $record.summary != "" then
      [tagged_section("compaction-summary"; ""; $record.summary)]
    elif $record.type == "branch_summary"
         and ($record.summary | type) == "string"
         and $record.summary != "" then
      [tagged_section("branch-summary"; ""; $record.summary)]
    else []
    end;

  # Positions index the whole branch, so --around can centre on a record
  # even when that record renders nothing under the current flags.
  . as $branch
  | (if $around == "" then null
     else first($branch | to_entries[] | select((.value.id? // null) == $around) | .key) // null
     end) as $target
  | [$branch | to_entries[]
    | .key as $pos
    | .value as $record
    | select($record | in_window)
    | {record: $record, pos: $pos, sections: render_sections($record)}
    | select(.sections | length > 0)] as $messages
  | {
      total: ($messages | length),
      messages: (
        $messages
        | if $target != null then
            ([.[] | select(.pos < $target)] | if $context == 0 then [] else .[-$context:] end)
            + [.[] | select(.pos == $target)]
            + ([.[] | select(.pos > $target)] | .[:$context])
          elif $count == null then .
          elif $count < 0 then .[$count:]
          else .[:$count]
          end
      )
    }
' "$branch_file" > "$render_plan"

body_file=$tmpdir/body
if $hydrate; then
  hydrated_items=$tmpdir/hydrated-items.jsonl
  : > "$hydrated_items"
  while IFS= read -r item; do
    record=$(jq -c '.record' <<<"$item")
    if jq -e '.type == "message" and .message.role == "toolResult"' >/dev/null <<<"$record"; then
      hydrate_record "$record" "$body_file"
      jq -c \
        --rawfile body "$body_file" \
        --arg state "$hydration_state" \
        '.record += {_omp_hydrated_body: $body, _omp_hydration_state: $state}' \
        <<<"$item" >> "$hydrated_items"
    else
      printf '%s\n' "$item" >> "$hydrated_items"
    fi
  done < <(jq -c '.messages[]' "$render_plan")

  hydrated_plan=$tmpdir/hydrated-plan.json
  jq -c --slurpfile messages "$hydrated_items" '.messages = $messages' \
    "$render_plan" > "$hydrated_plan"
  render_plan=$hydrated_plan
fi

jq -rj \
  --arg session "$session" \
  --argjson count "$slice_count" \
  --argjson hydrate "$hydrate" \
  --argjson ids "$ids" \
  --arg window "$(window_label)" \
  --arg around "$around_id" \
  --argjson context "$around_context" '
  def fence($body):
    ((([$body | scan("`+") | length] | max) // 0) + 1) as $length
    | "`" * (if $length < 3 then 3 else $length end);

  def hydrated_tool_section($record):
    $record._omp_hydrated_body as $body
    | ($record.message.toolName // "unknown") as $tool
    | (if $record.message.isError then "error" else "successful" end) as $status
    | fence($body) as $fence
    | if $record._omp_hydration_state == "unrecoverable" then
        "<tool-result tool=\"\($tool)\" status=\"\($status)\" recovered=\"false\">\n\($fence)\n\($body)\n\($fence)\n</tool-result>\n\n"
      else
        "<tool-result tool=\"\($tool)\" status=\"\($status)\" bytes=\"\($body | utf8bytelength)\">\n\($fence)\n\($body)\n\($fence)\n</tool-result>\n\n"
      end;

  if $hydrate then
    .messages |= map(
      if .record.type == "message" and .record.message.role == "toolResult" then
        .sections = [hydrated_tool_section(.record)]
      else .
      end)
  else .
  end
  | (if $around != "" then
       "- **Around:** `\($around)`, up to \($context) messages each side; \(.messages | length) of \(.total) shown\n"
     elif $count == null then ""
     else
       ($count | if . < 0 then . * -1 else . end) as $wanted
       | ([$wanted, .total] | min) as $shown
       | "- **Messages:** \(if $count < 0 then "last" else "first" end) \($shown) of \(.total)\n"
     end) as $messages_header
  | "# OMP transcript\n\n"
    + "- **Source:** `\($session)`\n"
    + (if $around == "" then "- **Branch:** active branch only\n"
       else "- **Branch:** the branch through `\($around)`\n" end)
    + (if $window == "" then "" else "- **Window:** \($window)\n" end)
    + $messages_header
    + "\n"
    + ([.messages[]
        | .record.id as $id
        | .sections[]
        | if $ids and ($id | type) == "string" and $id != "" then
            sub("^<(?<tag>[a-z-]+)"; "<\(.tag) id=\"\($id)\"")
          else .
          end]
       | join(""))
' "$render_plan"
